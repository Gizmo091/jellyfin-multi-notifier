# Server
PORT=3000
NODE_ENV=production

# Admin Authentication
ADMIN_PASSWORD=changeme

# Jellyfin
JELLYFIN_URL=http://jellyfin:8096
# API key for upgrade detection (optional - create in Jellyfin Dashboard > API Keys)
# If set, the service will skip notifications for quality upgrades
JELLYFIN_API_KEY=
WEBHOOK_SECRET=your-secret-here

# WhatsApp
# Auto-connect WhatsApp on startup (true/false, default: true)
# QR code will be displayed in terminal and sent via alerts
WHATSAPP_LOGIN_ON_STARTUP=true
# Phone number for pairing code auth (international format without +, e.g., 33612345678)
# If empty, QR code is used instead (recommended)
WHATSAPP_PHONE_NUMBER=

# Alerts (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# TMDB (optional, for cover images)
TMDB_API_KEY=

# Public URL for redirect links (used in notifications)
PUBLIC_URL=https://notifications.example.com

# Aggregation windows in minutes
# Notifications are grouped within these time windows before being sent
# Default value used if specific window not set:
AGGREGATION_WINDOW_MINUTES=15
# Per-type windows (optional, falls back to AGGREGATION_WINDOW_MINUTES):
AGGREGATION_WINDOW_MOVIES_MINUTES=15
AGGREGATION_WINDOW_SERIES_MINUTES=15
AGGREGATION_WINDOW_MOVIES_REMOVED_MINUTES=5
AGGREGATION_WINDOW_SERIES_REMOVED_MINUTES=5
